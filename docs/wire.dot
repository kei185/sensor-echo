digraph g {
        graph [rankdir=LR, labeljust="r"];
        node [shape=box];

        "YLidar" [
                shape=record 
                label="
                        YLidar (JST GH-1.25 female)
                        |<RX> RX
                        |<GND> GND
                        |<TX> TX
                        |<5V> 5V
                        "
        ];

        "DRV8835" [
                shape=record 
                label="
                        DRV8835 (Dupont female)
                                |<VM> VM
                                |<VCC> VCC
                                |<MODE> MODE
                                |<GND> GND
                                |<xOUT1> xOUT1
                                |<xOUT2> xOUT2
                                |<xIN1> xIN1
                                |<xIN2> xIN2
                        "
        ];
        "FIT0483" [
                shape=record 
                label="
                        FIT0483 (JST ZH?-1.5 female)
                                |<VCC-6V> VCC-6V
                                |<GND> GND
                                |<M1> M1
                                |<M2> M2
                                |<C1> C1
                                |<C2> C2
                        "
        ];
        "STM32IN" [
                shape=record 
                label="
                        STM32 (Dupont male)
                                |<GPIO> GPIO
                                |<GND> GND
                                "
        ];
        "STM32OUT" [
                shape=record 
                label="
                        STM32 (Dupont male)
                                |<GPIO> GPIO
                                "
        ];



        "POWER_6V" [
                shape=cylinder
                label="6V"
        ]

        "POWER_5V" [
                shape=cylinder
                label="5V"
        ]

        "GND_HUB" [
                shape=point
                xlabel="GND"
        ];

        "POWER_6V" -> "DRV8835":VM;

        "DRV8835":VM -> "FIT0483":"VCC-6V" ;
        "DRV8835":xOUT1-> "FIT0483":M1;
        "DRV8835":xOUT2 -> "FIT0483":M2;
        "FIT0483":C1 -> STM32IN:GPIO;
        "FIT0483":C2 -> STM32IN:GPIO;


        "FIT0483":GND -> "DRV8835":GND;

        "STM32OUT":GPIO -> "DRV8835":VCC ;
        "STM32OUT":GPIO -> "DRV8835":MODE ;
        "STM32OUT":GPIO -> "DRV8835":xIN1 ;
        "STM32OUT":GPIO -> "DRV8835":xIN2 ;

        POWER_5V -> YLidar:5V;
        YLidar -> STM32IN:GPIO;


}
